{
  "manifest_version": 3,
  "name": "JD Tailor",
  "version": "0.2.0",
  "description": "Capture the job description on any job page and have the AI agent already on your computer (Claude Code, Codex, Grok, DeepSeek) tailor your resume to it, with blind reviewers.",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "JD Tailor",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "sidePanel",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
