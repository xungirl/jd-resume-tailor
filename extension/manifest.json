{
  "manifest_version": 3,
  "name": "JD Tailor",
  "version": "0.1.0",
  "description": "Capture the job description on any job page and tailor your resume to it, with the AI account you connect. Never invents anything.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "JD Tailor", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "permissions": ["storage", "scripting", "activeTab", "sidePanel", "identity"],
  "host_permissions": ["https://openrouter.ai/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
